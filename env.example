# Xano API Configuration
# Replace with your actual Xano API URL
NEXT_PUBLIC_XANO_API_URL=https://xdil-abvj-o7rq.e2.xano.io/api:vnXelut6:develop

# Public app URL used for OAuth redirect URIs (no trailing slash)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Azure AD / Microsoft Entra SSO
# Register this redirect URI in Azure:
# https://<your-domain>/api/auth/callback/azure-ad
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common
# AZURE_AD_REDIRECT_URI=https://<your-domain>/api/auth/callback/azure-ad
# Optional override for Xano SSO exchange endpoint (defaults to {NEXT_PUBLIC_XANO_API_URL}/auth/azure/callback)
# XANO_AZURE_SSO_CALLBACK_URL=

# Example Xano API URL format:
# NEXT_PUBLIC_XANO_API_URL=https://your-project-id.e2.xano.io/api:your-api-version

# Vercel Configuration
# Uncomment and set your Vercel project ID to deploy to a specific project
# VERCEL_PROJECT_ID=your-vercel-project-id