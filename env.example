# Xano API Configuration
# Replace with your actual Xano API URL
NEXT_PUBLIC_XANO_API_URL=https://xdil-abvj-o7rq.e2.xano.io/api:vnXelut6

# Email alerts service (server-only — used by /api/email-alerts and /api/admin/email-analytics/* proxy routes)
ALERTS_API_KEY=

# Optional override for the email service host (defaults to https://asymmetrix-email-service.fly.dev)
# EMAIL_SERVICE_BASE_URL=https://asymmetrix-email-service.fly.dev

# Optional: set on the email alerts service (Fly) so /analytics/dcp can enrich company names,
# websites, and contribution status from Xano. Not read by this Next.js app directly.
# XANO_DCP_TRACKER_URL=https://...your-xano-endpoint...

# SSO — Azure AD / Microsoft Entra
# Register redirect URI: https://<your-domain>/api/auth/callback/azure-ad
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# AZURE_AD_REDIRECT_URI=https://<your-domain>/api/auth/callback/azure-ad

# SSO — Google OAuth
# Register redirect URI: https://<your-domain>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://<your-domain>/api/auth/callback/google

# Server-side Xano base URL for SSO callback (optional override per provider)
# XANO_BASE_URL=https://xdil-abvj-o7rq.e2.xano.io/api:vnXelut6
# XANO_AZURE_SSO_CALLBACK_URL=
# XANO_GOOGLE_SSO_CALLBACK_URL=

# Example Xano API URL format:
# NEXT_PUBLIC_XANO_API_URL=https://your-project-id.e2.xano.io/api:your-api-version

# Vercel Configuration
# Uncomment and set your Vercel project ID to deploy to a specific project
# VERCEL_PROJECT_ID=your-vercel-project-id 

# Redis (Upstash) - shared cache across serverless instances
# Add these in Vercel (Project → Settings → Environment Variables) or via Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: sector overview cache TTL (seconds). Default is 26 hours.
# SECTOR_CACHE_TTL_SECONDS=93600

# Optional: sector list-view cache TTL (seconds). Default is 26 hours.
# SECTOR_LIST_TTL_SECONDS=93600

# Optional: companies initial list cache TTL (seconds). Default is 26 hours.
# COMPANIES_INITIAL_TTL_SECONDS=93600

# Optional: investors initial list cache TTL (seconds). Default is 26 hours.
# INVESTORS_INITIAL_TTL_SECONDS=93600

# Optional: advisors initial list cache TTL (seconds). Default is 26 hours.
# ADVISORS_INITIAL_TTL_SECONDS=93600

# Optional: individuals initial list cache TTL (seconds). Default is 26 hours.
# INDIVIDUALS_INITIAL_TTL_SECONDS=93600

# Postmark — server token for admin email analytics (/api/admin/email-analytics)
POSTMARK_SERVER_TOKEN=

# Optional: Xano service bearer token
# XANO_SERVICE_TOKEN=

# Optional: protect cache invalidation and manual cron routes (x-cron-manual-secret header)
# CRON_MANUAL_SECRET=choose-a-long-random-string

# NEXT_PUBLIC_BASE_URL=https://www.asymmetrixintelligence.com

# Optional: Unlayer projectId (recommended). Without this, Unlayer often uses "project 0"
# and image uploads may go to Unlayer's default storage.
NEXT_PUBLIC_UNLAYER_PROJECT_ID=284114